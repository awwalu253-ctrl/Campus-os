# ── Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-me-with-a-64-char-random-string
SESSION_COOKIE_SECURE=false
SERVER_NAME=

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://campusos:campusos@localhost:5432/campusos
TEST_DATABASE_URL=postgresql+psycopg://campusos:campusos@localhost:5432/campusos_test

# ── SQLAlchemy pooling ─────────────────────────────────
# 1 Gunicorn worker × 4 threads = 4 concurrent slots.
# pool_size=3 + max_overflow=2 = 5 connections per process.
SQLALCHEMY_POOL_SIZE=3
SQLALCHEMY_MAX_OVERFLOW=2
SQLALCHEMY_POOL_TIMEOUT=10
SQLALCHEMY_POOL_RECYCLE=280

# ── Redis ──────────────────────────────────────────────
# Optional locally. Required for exact rate limiting.
# With memory:// storage and >1 thread, rate limits are approximate.
REDIS_URL=
RATELIMIT_ENABLED=true

# ── Celery (Phase 4+) ──────────────────────────────────
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Cloudflare R2 (Phase 2 image uploads) ──────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Mapbox ─────────────────────────────────────────────
MAPBOX_TOKEN=

# ── Mail ───────────────────────────────────────────────
MAIL_FROM=no-reply@campusos.app
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# ── Sentry (optional) ──────────────────────────────────
# Leave empty to disable. App works fine without it.
SENTRY_DSN=

# ── Branding ───────────────────────────────────────────
DEFAULT_UNIVERSITY_SLUG=unilorin

# ── Web Push (VAPID) ───────────────────────────────────
# Generate with:  python -m app.notifications.vapid_gen
# Or manually:    py-vapid --applicationServerKey
# Never commit the private key. Never log it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campusos.app