# ── Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-me-with-a-64-char-random-string
SESSION_COOKIE_SECURE=false
SERVER_NAME=

# ── Database ───────────────────────────────────────────
# PostGIS-enabled Postgres. Local dev example:
DATABASE_URL=postgresql+psycopg://campusos:campusos@localhost:5432/campusos

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Cloudflare R2 (used from Phase 2 onward) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Mapbox (used from Phase 3 onward) ──────────────────
MAPBOX_TOKEN=

# ── Mail (password reset architecture only in Ph1) ─────
MAIL_FROM=no-reply@campusos.app
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Branding / defaults ────────────────────────────────
DEFAULT_UNIVERSITY_SLUG=unilorin